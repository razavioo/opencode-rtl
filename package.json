{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-rtl",
  "version": "1.0.0",
  "description": "Comprehensive RTL language support plugin for opencode.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razavioo/opencode-rtl.git"
  },
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "index.js",
    "tui.js",
    "README.md"
  ],
  "engines": {
    "opencode": ">=2.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "release:stage": "npm test && npm stage publish"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "rtl",
    "bidi",
    "arabic",
    "persian",
    "hebrew",
    "urdu"
  ],
  "devDependencies": {
    "@opencode/plugin": "^2.0.17",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
